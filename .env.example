# Optional: Server-side Google Gemini API key for free daily user quota
# The app works 100% offline/locally without this key; users can also provide their own key (BYOK).
GEMINI_API_KEY=

# Optional: Gemini model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Free AI requests per IP per 24 hours (default: 10)
AI_DAILY_LIMIT=10
